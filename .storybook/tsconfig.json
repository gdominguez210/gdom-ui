{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "checkJs": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@storybook/manager-api": ["./node_modules/@storybook/manager-api"],
      "@storybook/theming/*": ["./node_modules/@storybook/theming/*"],
      "@/*": ["../*"]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./**/*.mdx",
    "*.ts",
  ]
} 